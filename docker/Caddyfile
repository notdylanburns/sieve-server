{
	# The proxy port: terminate the client's TLS with this site's certificate, then hand the raw
	# stream to Squid, which sees an ordinary explicit-proxy connection.
	layer4 {
		:3129 {
			route {
				# Squid only speaks HTTP/1.1. Chromium offers h2 to HTTPS proxies and, if it's
				# accepted, opens with the HTTP/2 preface, which Squid rejects.
				tls {
					connection_policy {
						alpn http/1.1
					}
				}
				proxy squid:3128
			}
		}
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}
