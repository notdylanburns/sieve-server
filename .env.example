# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32

# Public hostname. Caddy gets a certificate for it automatically, so DNS must point here and
# ports 80 and 443 must be reachable. "localhost" uses Caddy's own local CA instead.
DOMAIN=sieve.example.com

POSTGRES_PASSWORD=
# Signs sessions, device tokens and invite links. Changing it signs everyone out and
# invalidates every device token and invite link.
JWT_SECRET=

# Optional.
# "Sign in with Google": a Web application OAuth client whose authorized redirect URI is
# https://$DOMAIN/auth/redirect/google. Anyone with a Google account can then sign in; they
# get an account with no workspaces until someone invites them.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# YouTube makes requests from datacentre addresses sign in, so video titles and thumbnails
# fail on cloud hosts. These send yt-dlp's requests out through a Tailscale exit node at home
# instead; see the README.
#COMPOSE_PROFILES=tailscale
#TS_AUTHKEY=tskey-auth-...
#TS_EXIT_NODE=home-exit-node
#YT_DLP_PROXY=socks5://tailscale:1055
#AUDIT_RETENTION_DAYS=365
#RUST_LOG=info
# Read the database over the network (password auth; restrict with a firewall).
#POSTGRES_BIND=0.0.0.0
#POSTGRES_PORT=5432
# Published ports, e.g. for rootless containers that can't bind below 1024.
#HTTP_PORT=80
#HTTPS_PORT=443
#PROXY_PORT=3129
# Change if it collides with another network on this host.
#SIEVE_SUBNET=172.31.250.0/24
